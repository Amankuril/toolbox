{
  "name": "toolshubs-backend",
  "version": "1.0.0",
  "private": true,
  "description": "ToolsHubs marketplace API (admin, vendor, user)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.12"
  },
  "imports": {
    "#config/*": "./src/config/*",
    "#core/*": "./src/core/*",
    "#services/*": "./src/services/*",
    "#modules/*": "./src/modules/*"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "seed:admin": "node --env-file-if-exists=.env scripts/seed-admin.js",
    "seed:catalog": "node --env-file-if-exists=.env scripts/seed-catalog.js",
    "db:sync-indexes": "node --env-file-if-exists=.env scripts/sync-indexes.js",
    "db:local": "node scripts/local-mongo.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sms:test": "node --env-file-if-exists=.env scripts/test-sms.js",
    "mail:test": "node --env-file-if-exists=.env scripts/test-mail.js",
    "db:backfill-cart-vendors": "node --env-file-if-exists=.env scripts/backfill-cart-vendors.js"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "file-type": "^22.1.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.15",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limiter-flexible": "^11.2.1",
    "razorpay": "^2.9.8",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
