# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
APP_NAME=ToolsHubs
LOG_LEVEL=info
# Number of reverse proxies in front of the API (nginx = 1)
TRUST_PROXY=1

# Browser origins allowed to call the API (comma separated). Required in production.
CORS_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# ─── Data stores ───────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/toolshubs
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=tb:

# ─── Secrets ───────────────────────────────────────────────────────────────
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ONBOARDING_SECRET=
OTP_HMAC_SECRET=
# 32 bytes, generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Encrypts vendor bank account numbers. NEVER change it once data exists.
DATA_ENCRYPTION_KEY=

JWT_ACCESS_TTL=15m
JWT_ONBOARDING_TTL=20m
REFRESH_TOKEN_TTL_DAYS=30
# COOKIE_DOMAIN=.yourdomain.com
# COOKIE_SECURE=true   (defaults to true in production)

# ─── OTP ───────────────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=45
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5
OTP_LOCK_MINUTES=15
# Comma-separated list of phone numbers that always use dummy OTP 123456 (bypasses SMS gateway in dev/prod)
# Example: DUMMY_NUMBERS=9999900001,9999900002
DUMMY_NUMBERS=

# ─── SMS (SMSIndiaHub) ─────────────────────────────────────────────────────
# console = log OTPs to the server log (development only; refused in production)
SMS_PROVIDER=console
SMSINDIAHUB_BASE_URL=https://cloud.smsindiahub.in/vendorsms/pushsms.aspx
SMSINDIAHUB_API_KEY=
SMSINDIAHUB_SENDER_ID=
# 2 = transactional
SMSINDIAHUB_CHANNEL=2
# Optional: panel username, only if your account requires "uname".
SMSINDIAHUB_USERNAME=
# DLT principal entity id (PE ID) and the approved OTP template id
SMSINDIAHUB_OTP_TEMPLATE_ID=
# Must match the DLT-approved template exactly. Placeholders: {otp} {minutes} {app}
SMSINDIAHUB_OTP_TEMPLATE="{otp} is your {app} verification code. It is valid for {minutes} minutes. Do not share it with anyone."

# ─── Storage ───────────────────────────────────────────────────────────────
# The admin panel toggle picks the provider: ON → Cloudinary, OFF → local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=toolshubs
# Server folder path where files are written on disk (e.g. /var/www/ToolsHubUploads)
LOCAL_UPLOAD_DIR=/var/www/ToolsHubUploads
# URL path used in HTML and served by Nginx (must match nginx config: location /uploads/)
LOCAL_UPLOAD_PUBLIC_PATH=/uploads
UPLOAD_MAX_FILE_SIZE_MB=8
UPLOAD_MAX_FILES=10
IMAGE_MAX_DIMENSION=1600
IMAGE_WEBP_QUALITY=80

# ─── Payments (Razorpay) ───────────────────────────────────────────────────
# Keys from Razorpay Dashboard -> Settings -> API Keys (test: rzp_test_..., prod: rzp_live_...)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret from Razorpay Dashboard -> Settings -> Webhooks
# Webhook URL: https://yourdomain.com/api/v1/webhooks/razorpay
# Required events: payment.captured, order.paid, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=
# Time in minutes unconfirmed online orders hold inventory stock before expiration
ORDER_PAYMENT_WINDOW_MINUTES=30


# ─── Shipping (Shipmozo) ───────────────────────────────────────────────────
# Keys from Shipmozo panel -> profile (or the Shipmozo login API). Server-side only; never expose to the frontend.
# No trailing slash on the base URL.
SHIPMOZO_BASE_URL=https://shipping-api.com/app/api/v1
SHIPMOZO_PUBLIC_KEY=
SHIPMOZO_PRIVATE_KEY=
SHIPMOZO_TIMEOUT_MS=15000

# ─── Pincode lookup (India Post, free, no key) ─────────────────────────────
# Auto-fills city/state from a pincode in address forms. Defaults work as-is.
# PINCODE_LOOKUP_URL=https://api.postalpincode.in/pincode
# PINCODE_LOOKUP_TIMEOUT_MS=5000

# ─── Email (SMTP) ───────────────────────────────────────────────────────────
# console = log only (dev/tests); smtp = real sending. Gmail: smtp.gmail.com:465 + an App Password.
MAIL_PROVIDER=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# The Gmail address that owns the App Password below.
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER. Gmail only allows your own address (or a verified alias) here.
MAIL_FROM=
MAIL_FROM_NAME=ToolsHubs
